<MainScreen>:
    canvas.before:
        Rectangle:
            source: 'assets/images/pole.png'
            pos: self.pos
            size: self.size
    MDBoxLayout:
        orientation: 'vertical'
        padding: '50dp'
        spacing: '30dp'
        MDIconButton:
            icon: "cog"
            pos_hint: {'right': 1}
            icon_size: '50dp'
        Image:
            source: 'assets/images/rocket.png'
            size_hint_y: 0.7
            size: dp(50), dp(50)
            allow_stretch: True
        MDRectangleFlatButton:
            text: "PLAY"
            font_size: '60sp'
            pos_hint: {'center_x': 0.5,'center_y': 0.5}
            on_press:
                root.manager.current = 'game'

<Ship>:
    size_hint: None, None

<PlayerShip@Ship>:
    source: 'assets/images/rocket.png'
    size: dp(80), dp(194)
    canvas.before:
        PushMatrix
        Rotate:
            angle: self.tilt_angle
            origin: self.center
    canvas.after:
        PopMatrix

<EnemyShip@Ship>:
    source: 'assets/images/ufo.png'
    size: dp(70), dp(70)

<BossShip@Ship>:
    source: 'assets/images/boss.png'
    size: dp(120), dp(120)

<BossBullet>:
    size_hint: None, None
    canvas:
        Color:
            rgba: 1, 1, 1, 1
        Ellipse:
            pos: self.pos
            size: self.size

<GameScreen>:
    canvas.before:
        Color:
            rgba: (0, 0, 0, 1) if root.is_boss_fight else (1, 1, 1, 1)
        Rectangle:
            source: '' if root.is_boss_fight else 'assets/images/pole.png'
            pos: self.pos
            size: self.size

    MDFloatLayout:
        id: game
        MDFloatLayout:
            id: back
        MDFloatLayout:
            id: front
            PlayerShip:
                id: ship
                pos: root.center_x - dp(40), dp(100)

    MDFloatLayout:
        id: interface
        # Очки та дистанція у верхньому лівому кутку
        MDBoxLayout:
            orientation: 'vertical'
            size_hint: None, None
            size: dp(200), dp(80)
            pos_hint: {'top': 0.98, 'left': 0.02}
            spacing: dp(2)
            MDLabel:
                text: f"Score: {root.score}"
                font_size: '18sp'
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                bold: True
            MDLabel:
                text: f"Distance: {int(root.distance)} m"
                font_size: '18sp'
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                bold: True

        # --- HP-БАР БОССА (Отображается во время Боссфайта) ---
        Widget:
            size_hint: None, None
            size: dp(260), dp(24)
            pos_hint: {'center_x': 0.5, 'top': 0.96}
            opacity: 1 if root.is_boss_fight else 0
            canvas:
                # Подложка (тёмная)
                Color:
                    rgba: 0.2, 0, 0, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                # Здоровье босса (Красный)
                Color:
                    rgba: 0.9, 0.1, 0.1, 1
                Rectangle:
                    pos: self.pos
                    size: (self.width * (root.boss_hp / root.boss_max_hp)), self.height
                # Белая рамка Undertale-style
                Color:
                    rgba: 1, 1, 1, 1
                Line:
                    rectangle: (self.x, self.y, self.width, self.height)
                    width: 1.5

        MDLabel:
            text: f"BOSS HP: {int(root.boss_hp)} / {root.boss_max_hp}"
            font_size: '14sp'
            bold: True
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(200), dp(24)
            pos_hint: {'center_x': 0.5, 'top': 0.96}
            halign: 'center'
            valign: 'middle'
            opacity: 1 if root.is_boss_fight else 0

        # --- НАШ HP-БАР (ФЛАГ УКРАИНЫ: СИНИЙ ВЕРХ, ЖЁЛТЫЙ НИЗ) ---
        Widget:
            id: player_hp_bar
            size_hint: None, None
            size: dp(180), dp(22)
            pos_hint: {'x': 0.04, 'y': 0.09}
            canvas:
                # Фон шкалы (темный)
                Color:
                    rgba: 0.1, 0.1, 0.1, 0.8
                Rectangle:
                    pos: self.pos
                    size: self.size

                # Верхняя синяя половина
                Color:
                    rgba: 0.0, 0.34, 0.72, 1
                Rectangle:
                    pos: (self.x, self.y + self.height * 0.5)
                    size: (self.width * (root.player_hp / root.player_max_hp)), self.height * 0.5

                # Нижняя жёлтая половина
                Color:
                    rgba: 1.0, 0.84, 0.0, 1
                Rectangle:
                    pos: (self.x, self.y)
                    size: (self.width * (root.player_hp / root.player_max_hp)), self.height * 0.5

                # Белая рамка
                Color:
                    rgba: 1, 1, 1, 1
                Line:
                    rectangle: (self.x, self.y, self.width, self.height)
                    width: 1.5

        MDLabel:
            text: f"HP: {int(root.player_hp)} / {root.player_max_hp}"
            font_size: '13sp'
            bold: True
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(180), dp(22)
            pos_hint: {'x': 0.04, 'y': 0.09}
            halign: 'center'
            valign: 'middle'

        # Кнопки управления
        MDBoxLayout:
            spacing: dp(20)
            padding: dp(20)
            Widget:
            MDFloatingActionButton:
                icon: "pause"
                pos_hint: {'top': 1}
                on_press: root.show_menu()
            Widget:

        MDBoxLayout:
            spacing: dp(15)
            padding: dp(15)
            MDFloatingActionButton:
                icon: "arrow-left-bold"
                on_press: root.pressKey('left')
                on_release: root.releaseKey('left')

            MDFloatingActionButton:
                icon: "arrow-right-bold"
                md_bg_color: app.theme_cls.primary_color
                on_press: root.pressKey('right')
                on_release: root.releaseKey('right')
            Widget:
            MDFloatingActionButton:
                icon: "arrow-up-bold"
                md_bg_color: app.theme_cls.primary_color
                on_press: root.pressKey('shot')
                on_release: root.releaseKey('shot')

<Cloud>:
    size_hint: None, None
    canvas:
        Color:
            rgba: 1, 1, 1, 0.55
        Ellipse:
            pos: self.x, self.y + self.height * 0.15
            size: self.width * 0.6, self.height * 0.6
        Ellipse:
            pos: self.x + self.width * 0.25, self.y + self.height * 0.35
            size: self.width * 0.55, self.height * 0.55
        Ellipse:
            pos: self.x + self.width * 0.45, self.y
            size: self.width * 0.6, self.height * 0.6

<Shot>:
    size_hint: None, None
    size: dp(12), dp(20)
    md_bg_color: app.theme_cls.primary_color
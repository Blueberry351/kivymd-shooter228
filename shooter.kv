<MainScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        padding: '50dp'
        spacing: '30dp'
        MDIconButton:
            icon: "cog"
            pos_hint: {'right': 1}
            icon_size: '50dp'
        Image:
            source: 'assets/images/rocket.png'
            size_hint_y: 0.7
            size: dp(50), dp(50)
            allow_stretch: True
        MDRectangleFlatButton:
            text: "PLAY"
            font_size: '60sp'
            pos_hint: {'center_x': 0.5,'center_y': 0.5}
            on_press:
                root.manager.current = 'game'

<Ship>:
    size_hint: None, None

<PlayerShip@Ship>:
    source: 'assets/images/rocket.png'
    size: dp(100), dp(243)


<EnemyShip@Ship>:
    source: 'assets/images/ufo.png'
    size: dp(100), dp(100)


<GameScreen>:
    # Прибрали фон через canvas, залишається стандартний темний колір теми
    MDFloatLayout:
        id: game
        MDFloatLayout:
            id: front
            PlayerShip:
                id: ship
                pos: root.center_x, dp(50)

    MDFloatLayout:
        id: interface
        # Очки та дистанція у верхньому лівому кутку білим кольором
        MDBoxLayout:
            orientation: 'vertical'
            size_hint: None, None
            size: dp(200), dp(80)
            pos_hint: {'top': 0.98, 'left': 0.02}
            spacing: dp(2)
            MDLabel:
                text: f"Score: {root.score}"
                font_size: '20sp'
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                bold: True
            MDLabel:
                text: f"Distance: {int(root.distance)} m"
                font_size: '20sp'
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                bold: True

        MDBoxLayout:
            spacing: dp(20)
            padding: dp(20)
            Widget:
            MDFloatingActionButton:
                icon: "pause"
                pos_hint: {'top': 1}
                on_press: root.show_menu()
            Widget:
        MDBoxLayout:
            spacing: dp(20)
            padding: dp(20)
            MDFloatingActionButton:
                icon: "arrow-left-bold"
                on_press: root.pressKey('left')
                on_release: root.releaseKey('left')

            MDFloatingActionButton:
                icon: "arrow-right-bold"
                md_bg_color: app.theme_cls.primary_color
                on_press: root.pressKey('right')
                on_release: root.releaseKey('right')
            Widget:
            MDFloatingActionButton:
                icon: "arrow-up-bold"
                md_bg_color: app.theme_cls.primary_color
                on_press: root.pressKey('shot')
                on_release: root.releaseKey('shot')


<Shot>:
    size_hint: None, None
    size: 20, 20
    md_bg_color: app.theme_cls.primary_color